{
  "$defs": {
    "Applicability": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "always",
          "enum": [
            "always",
            "equals"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "title": "Applicability",
      "type": "object"
    },
    "ExceptionRule": {
      "additionalProperties": false,
      "properties": {
        "allowed_statuses": {
          "items": {
            "enum": [
              "unmet",
              "unknown"
            ],
            "type": "string"
          },
          "title": "Allowed Statuses",
          "type": "array"
        },
        "role": {
          "const": "owner",
          "default": "owner",
          "title": "Role",
          "type": "string"
        }
      },
      "title": "ExceptionRule",
      "type": "object"
    },
    "Method": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "required_values",
            "equal_values",
            "reconcile_records",
            "evidence_binding",
            "semantic_review"
          ],
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "Method",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Applicability"
        },
        "check": {
          "$ref": "#/$defs/Method"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "exception": {
          "$ref": "#/$defs/ExceptionRule"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "risk_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Risk Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "risk_ids",
        "check"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "ReviewRules": {
      "additionalProperties": false,
      "properties": {
        "decision_max_age_seconds": {
          "default": 3600,
          "maximum": 31536000,
          "minimum": 1,
          "title": "Decision Max Age Seconds",
          "type": "integer"
        },
        "evidence_max_age_seconds": {
          "default": 86400,
          "maximum": 31536000,
          "minimum": 1,
          "title": "Evidence Max Age Seconds",
          "type": "integer"
        },
        "permitted_condition_types": {
          "items": {
            "const": "host_check",
            "type": "string"
          },
          "title": "Permitted Condition Types",
          "type": "array"
        }
      },
      "title": "ReviewRules",
      "type": "object"
    },
    "Risk": {
      "additionalProperties": false,
      "properties": {
        "applies_to": {
          "enum": [
            "proceed",
            "hold",
            "both"
          ],
          "title": "Applies To",
          "type": "string"
        },
        "consequence": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Consequence",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "applies_to",
        "id",
        "title",
        "consequence"
      ],
      "title": "Risk",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "action_types": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Action Types",
          "type": "array"
        },
        "work_types": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Work Types",
          "type": "array"
        }
      },
      "required": [
        "work_types",
        "action_types"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "review_rules": {
      "$ref": "#/$defs/ReviewRules"
    },
    "risks": {
      "items": {
        "$ref": "#/$defs/Risk"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Risks",
      "type": "array"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    }
  },
  "required": [
    "scope",
    "risks",
    "requirements"
  ],
  "title": "Definition",
  "type": "object"
}
