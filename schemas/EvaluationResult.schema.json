{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "interpretation": {
          "title": "Interpretation",
          "type": "boolean"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        },
        "requirement_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requirement Id"
        },
        "risk_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Risk Ids",
          "type": "array"
        },
        "scope": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "scope",
        "risk_ids",
        "requirement_id",
        "method",
        "references",
        "interpretation"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Method": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "required_values",
            "equal_values",
            "reconcile_records",
            "evidence_binding",
            "semantic_review"
          ],
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "Method",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "requirement_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "question",
        "requirement_id",
        "finding_id"
      ],
      "title": "Question",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "enum": [
            "yes",
            "no"
          ],
          "title": "Answer",
          "type": "string"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "answer",
        "reason"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source": {
          "enum": [
            "work",
            "context",
            "evidence"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "Reference",
      "type": "object"
    },
    "RequirementResult": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        },
        "requirement_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "met",
            "unmet",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "status",
        "explanation",
        "method",
        "references"
      ],
      "title": "RequirementResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "limits": {
      "items": {
        "type": "string"
      },
      "title": "Limits",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "title": "Questions",
      "type": "array"
    },
    "recommendation": {
      "$ref": "#/$defs/Recommendation"
    },
    "requirement_results": {
      "items": {
        "$ref": "#/$defs/RequirementResult"
      },
      "title": "Requirement Results",
      "type": "array"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    }
  },
  "required": [
    "recommendation",
    "requirement_results",
    "findings",
    "questions",
    "limits",
    "valid_until"
  ],
  "title": "EvaluationResult",
  "type": "object"
}
