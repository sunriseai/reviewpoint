            "always",
            "equals"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "title": "Applicability",
      "type": "object"
    },
    "ExceptionRule": {
      "additionalProperties": false,
      "properties": {
        "allowed_statuses": {
          "items": {
            "enum": [
              "unmet",
              "unknown"
            ],
