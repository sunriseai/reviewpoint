          },
          "title": "Allowed Statuses",
          "type": "array"
        },
        "role": {
          "const": "owner",
          "default": "owner",
          "title": "Role",
          "type": "string"
        }
      },
      "title": "ExceptionRule",
      "type": "object"
    },
    "Method": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "required_values",
            "equal_values",
            "reconcile_records",
            "evidence_binding",
            "semantic_review"
          ],
          "title": "Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
